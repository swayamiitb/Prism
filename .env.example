# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  Context Brain — environment configuration                                ║
# ║  Copy this file to `.env` and adjust. NOTHING here requires a paid key.   ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ─── Runtime ────────────────────────────────────────────────────────────────
# dev = hot-reload, no auth gate. prd = strict (not enforced in MVP).
RUNTIME_ENV=dev

# ─── Ollama (local model runtime) ───────────────────────────────────────────
# In Docker, the API service talks to the `ollama` service.
OLLAMA_HOST=http://localhost:11434
# Reasoning brain — Gemma 4 (released Apr 2026), built for agentic workflows,
# under 31B params. (Alternative on stronger hardware: gemma4:26b-a4b, MoE.)
OLLAMA_CHAT_MODEL=gemma4:12b
# Embedding model for semantic node search (multilingual, 8K ctx).
OLLAMA_EMBED_MODEL=bge-m3
# Generation tuning.
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=32768

# ─── Neo4j (the company knowledge graph) ────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=brain-dev-password
# Change in any shared environment.
NEO4J_AUTH_PASSWORD=brain-dev-password

# ─── Seeded sample data (default — zero credentials) ────────────────────────
# The Brain ships with a fictional company "Northwind" so it runs instantly.
# Override the paths to point at your own data, or set the integration vars
# below to use real Slack / Google Drive.
WIKI_PATH=
SLACK_PATH=
DRIVE_PATH=

# ─── Optional: real integrations (default: seeded sample data) ──────────────
# Set a Slack bot token (xoxb-...) to read a real workspace instead of the seed.
SLACK_BOT_TOKEN=
# Path to a Google service-account JSON to read real Drive docs.
GOOGLE_SERVICE_ACCOUNT_FILE=

# ─── Skills engine ──────────────────────────────────────────────────────────
# Where exported executable .skill.yml files are written.
SKILLS_EXPORT_DIR=skills

# ─── API server ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── Knowledge graph tuning ─────────────────────────────────────────────────
# Default traversal depth for "who owns X / what connects to X" graph queries.
GRAPH_DEFAULT_HOPS=2
# Confidence floor (0.0–1.0) for edges surfaced in the visualization.
GRAPH_MIN_CONFIDENCE=0.3
